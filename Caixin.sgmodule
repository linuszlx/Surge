#!name=财新去广告
#!desc = 优化财新客户端，去除广告
#!category = 去广告

[MITM]
hostname = %APPEND% gateway.caixin.com, msgapi.caixin.com, gg.caixin.com, dolphin.caixin.com, www.caixin.com

[URL Rewrite]
# > 文章页猜你想问
^https:\/\/www\.caixin\.com\/ai\/question\/\d+\/\d+\.js - reject-200
# > 原生广告 / 开屏 / 信息流 / Banner
^https:\/\/gg\.caixin\.com\/s - reject-200
# > 文章页广告
^https:\/\/dolphin\.caixin\.com\/s - reject-200
# > 数据统计上报
^https:\/\/gateway\.caixin\.com\/api\/stat\/v\d\/client_data\/from_app - reject-200

[Body Rewrite]
# > 广告配置 / AI入口 / 商城 / 热选
http-response-jq ^https:\/\/gateway\.caixin\.com\/api\/app-api\/caixinapp\/appinfo jq='.data.adConfig.audio_ad=[] | .data.adConfig.article_ad=[] | .data.adConfig.channel_list_ad=[] | .data.memberCharge=null | .data.inviteFriend=null | .data.topLeftBtnList=[] | .data.userCenterSettingsConfigV2.memberCharge=[] | .data.userCenterSettingsConfigV2.topLeftBtnList=[] | .data.userCenterSettingsConfigV2.topRightBtnList=((.data.userCenterSettingsConfigV2.topRightBtnList // []) | map(select(.code!="hotSelection"))) | .data.channel.channel_show=((.data.channel.channel_show // []) | map(select(.id!="186" and .name!="AI荐读"))) | .data.channel.channel_hide=((.data.channel.channel_hide // []) | map(select(.id!="186" and .name!="AI荐读"))) | .data.channelList=((.data.channelList // []) | map(select(.id!=186 and .name!="AI荐读"))) | .data.homePageWatchingList=((.data.homePageWatchingList // []) | map(select(.title!="AI全景"))) | .data.aiConfig=null | .data.isShowAiPairedReading="0" | .data.isShowAiAbFeature="0"'
# > AI荐读频道
http-response-jq ^https:\/\/gateway\.caixin\.com\/api\/app-api\/userChannelNew\/getUserChannel jq='.data=((.data // []) | map(select(.channelId!=186)))'
# > 广告数据
http-response-jq ^https:\/\/gateway\.caixin\.com\/api\/app-api\/adInfoData\/getDateAdAll jq='.data=[]'
# > 启动页运营海报
http-response-jq ^https:\/\/gateway\.caixin\.com\/api\/app-api\/poster\/getAll jq='.data=[]'
# > 气泡 / 运营提示
http-response-jq ^https:\/\/gateway\.caixin\.com\/api\/app-api\/cxBubbleInfo\/getCxBubbleInfo(?:V3)? jq='.data=[]'
# > 公告 / AI荐读推广
http-response-jq ^https:\/\/msgapi\.caixin\.com\/msg_api\/annmsg\/annlist\/ jq='.data=[]'
# > 搜索推荐词 / 热点新闻
http-response-jq ^https:\/\/gateway\.caixin\.com\/api\/app-api\/search\/getkeyword jq='.data.keys=[] | .data.hot_news=[]'
# > 热门
http-response-jq ^https:\/\/gateway\.caixin\.com\/api\/app-api\/articlesHotRecommend\/getHotRecommendArticles jq='.data.hotRecommendArticleList=[]'


