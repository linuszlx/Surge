# 高位端口通用匹配
URL-REGEX,"^http:\/\/((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?):\d+\/httpdns\/",REJECT,extended-matching
URL-REGEX,"^http:\/\/\[[0-9a-fA-F:]+\]:\d+\/httpdns\/",REJECT,extended-matching



[Map Local]
# 喜马拉雅 LinkEye HTTPDNS 调度
^https:\/\/gslbali\.ximalaya\.com\/linkeye-cloud\/httpdns\/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

# 支付宝 AMDC 调度（防红字网络报错，返回空字典使其平滑降级走本地 DNS）
^https?:\/\/amdc\.alipay\.com\/query data-type=text data="{}" status-code=200 header="Content-Type:application/json"

# 淘系 AMDC HTTPS 调度接口
^https:\/\/amdc\.m\.taobao\.com\/amdc\/mobileDispatch data-type=text data="{}" status-code=200 header="Content-Type:application/json"


[MITM]
hostname = %APPEND% amdc.alipay.com, amdc.m.taobao.com, gslbali.ximalaya.com
