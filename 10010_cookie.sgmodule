#!name = 10010 Cookie 抓取规则
#!desc = 抓取cookie
#!author = linusz
#!category = 工具


[MITM]
hostname = %APPEND% m.client.10010.com

[Script]
# 自动抓取中国联通 riskSync 请求的 Cookie
10010_cookie = type=http-request,pattern=^https:\/\/m\.client\.10010\.com\/mobileserviceNine\/v1\/riskCollection\/riskSync,script-path=https://raw.githubusercontent.com/Nanako718/Scripting/refs/heads/main/Quantumult%20X/js/10010_cookie.js,requires-body=0,max-size=0
