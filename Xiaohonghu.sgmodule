#!name=小红书
#!desc=小红书去广告
#!category = 去广告
#!date=2026-11-08 00:00:00

[Rule]
DOMAIN, ads-img-al.xhscdn.com, REJECT
DOMAIN, ads-img-qc.xhscdn.com, REJECT
DOMAIN, ads-video-al.xhscdn.com, REJECT
DOMAIN, ads-video-qc.xhscdn.com, REJECT
DOMAIN, t-ads.xiaohongshu.com, REJECT
AND, ((PROTOCOL, UDP), (DEST-PORT, 443), (OR, ((DOMAIN-SUFFIX, xiaohongshu.com), (DOMAIN-SUFFIX, rnote.com)))), REJECT-NO-DROP

[URL Rewrite]
# 评论区图片水印 (200 拦截图片)
^https?:\/\/ci\.(?:xiaohongshu|rnote)\.com\/system_config\/watermark - reject-200

[Map Local]
# 惊喜弹窗 
^https:\/\/edith\.(?:xiaohongshu|rnote)\.com\/api\/sns\/v1\/surprisebox\/(?:get_style|open|submit_action) data="{}" status=200 header="Content-Type: application/json; charset=utf-8"
^https:\/\/www\.(?:xiaohongshu|rnote)\.com\/api\/marketing\/box\/trigger\? data="{}" status=200 header="Content-Type: application/json; charset=utf-8"
# 信息流引导/广告
^https:\/\/edith\.(?:xiaohongshu|rnote)\.com\/api\/sns\/v\d+\/(?:guide\/user_banner|note\/guide) data="{}" status=200 header="Content-Type: application/json; charset=utf-8"
^https:\/\/www\.(?:xiaohongshu|rnote)\.com\/api\/sns\/v\d+\/(?:ads\/resource|hey\/\w+\/hey_gallery) data="{}" status=200 header="Content-Type: application/json; charset=utf-8"
# 简单空字典（Surge 标准语法）
^https:\/\/edith\.(?:xiaohongshu|rnote)\.com\/api\/sns\/v1\/search\/banner_list$ data="{}" data-type=text
^https:\/\/edith\.(?:xiaohongshu|rnote)\.com\/api\/sns\/v1\/search\/hot_list$ data="{\"data\":{\"items\":[]}}" data-type=text
^https:\/\/edith\.(?:xiaohongshu|rnote)\.com\/api\/sns\/v4\/search\/hint data="{\"data\":{\"hint_words\":[]}}" data-type=text
^https:\/\/edith\.(?:xiaohongshu|rnote)\.com\/api\/sns\/v4\/search\/trending\? data="{\"data\":{\"queries\":[],\"hint_word\":{}}}" data-type=text

[Script]
# 界面整体配置
小红书_移除整体配置 = type=http-response,pattern=^https:\/\/edith\.(?:xiaohongshu|rnote)\.com\/api\/sns\/v1\/system\/service\/ui\/config\?,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/linuszlx/Loonx/main/Script/RedNote/xiaohongshu-2.js
# 开屏广告
小红书_开屏配置 = type=http-response,pattern=^https:\/\/edith\.(?:xiaohongshu|rnote)\.com\/api\/sns\/v1\/system_service\/config\?,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/linuszlx/Loonx/main/Script/RedNote/xiaohongshu-2.js
小红书_开屏广告 = type=http-response,pattern=^https:\/\/edith\.(?:xiaohongshu|rnote)\.com\/api\/sns\/v2\/system_service\/splash_config,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/linuszlx/Loonx/main/Script/RedNote/xiaohongshu-2.js
# 详情页、关注页
小红书_详情页小部件 = type=http-response,pattern=^https:\/\/edith\.(?:xiaohongshu|rnote)\.com\/api\/sns\/v2\/(?:note\/widgets|user\/followings\/followfeed),requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/linuszlx/Loonx/main/Script/RedNote/xiaohongshu-2.js
小红书_感兴趣的人 = type=http-response,pattern=^https:\/\/edith\.(?:xiaohongshu|rnote)\.com\/api\/sns\/v5\/recommend\/user\/follow_recommend\?,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/linuszlx/Loonx/main/Script/RedNote/xiaohongshu-2.js
# 信息流
# 小红书_显示时间 = type=http-response,pattern=^https:\/\/(?:edith|rec|www)\.(?:xiaohongshu|rnote)\.com\/api\/sns\/v6\/homefeed\?,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/linuszlx/Loonx/main/Script/RedNote/RedNote.feedtime.js
小红书_关注流广告 = type=http-response,pattern=^https:\/\/(?:edith|rec|www)\.(?:xiaohongshu|rnote)\.com\/api\/sns\/v4\/followfeed\?,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/linuszlx/Loonx/main/Script/RedNote/xiaohongshu-2.js
小红书_推荐流广告 = type=http-response,pattern=^https:\/\/(?:edith|rec|www)\.(?:xiaohongshu|rnote)\.com\/api\/sns\/v6\/homefeed\?,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/linuszlx/Loonx/main/Script/RedNote/xiaohongshu-2.js
# 搜索页
小红书_搜索页广告 = type=http-response,pattern=^https:\/\/(?:edith|so)\.(?:xiaohongshu|rnote)\.com\/api\/sns\/v10\/search\/notes\?,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/linuszlx/Loonx/main/Script/RedNote/xiaohongshu-2.js
# 实况、图片、视频水印
小红书_水印_LivePhoto = type=http-response,pattern=^https:\/\/(?:edith|rec|www)\.(?:xiaohongshu|rnote)\.com\/api\/sns\/v1\/note\/(?:imagefeed|live_photo\/save),requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/linuszlx/Loonx/main/Script/RedNote/xiaohongshu-2.js
小红书_水印_Feed = type=http-response,pattern=^https:\/\/(?:edith|rec|www)\.(?:xiaohongshu|rnote)\.com\/api\/sns\/(?:v2\/note\/feed|v3\/note\/videofeed),requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/linuszlx/Loonx/main/Script/RedNote/xiaohongshu-2.js
小红书_水印_VideoSave = type=http-response,pattern=^https:\/\/(?:edith|rec|www)\.(?:xiaohongshu|rnote)\.com\/api\/sns\/(?:v4\/note\/videofeed|v10\/note\/video\/save),requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/linuszlx/Loonx/main/Script/RedNote/xiaohongshu-2.js
# 评论区图片、Live图水印、表情包下载
小红书_评论区水印 = type=http-response,pattern=^https:\/\/edith\.(?:xiaohongshu|rnote)\.com\/api\/sns\/(?:v1\/interaction\/comment\/video\/download|v5\/note\/comment\/list|v3\/note\/comment\/sub_comments),requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/linuszlx/Loonx/main/Script/RedNote/xiaohongshu.js

[MITM]
hostname = %APPEND% ci.xiaohongshu.com, edith.xiaohongshu.com, rec.xiaohongshu.com, www.xiaohongshu.com, so.xiaohongshu.com, ci.rnote.com, edith.rnote.com, rec.rnote.com, www.rnote.com, so.rnote.com
