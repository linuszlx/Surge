#!name=拼多多去广告
#!desc=移除开屏广告、底栏多多视频、会场入口、聊天页面精选推荐及推广，精简首页和个人中心。
#!category=去广告
#!date=2026-9-18 17:26:24

[Rule]
AND,((URL-REGEX, ^http:\/\/((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\/d(\d)?), (USER-AGENT, *com.xunmeng.pinduoduo*)), REJECT
AND,((URL-REGEX, ^http:\/\/\[[0-9a-fA-F:]+\]\/d(\d)?\?), (USER-AGENT, *com.xunmeng.pinduoduo*)), REJECT
AND,((DOMAIN, api.pinduoduo.com), (PROTOCOL, QUIC)), REJECT
DOMAIN, titan.pinduoduo.com, REJECT
DOMAIN, xg.pinduoduo.com, REJECT
DOMAIN, cdl-1.pddpic.com, REJECT
DOMAIN, cdl-p2.pddpic.com, REJECT
DOMAIN, cd-1.pddpic.com, REJECT
DOMAIN, apm.pinduoduo.com, REJECT
DOMAIN, th-b.pinduoduo.com, REJECT
DOMAIN, ta.pinduoduo.com, REJECT
DOMAIN, th.pinduoduo.com, REJECT
DOMAIN, th-a.pinduoduo.com, REJECT
DOMAIN, ta-a.pinduoduo.com, REJECT
DOMAIN, meta.pinduoduo.com, REJECT
DOMAIN, apm-a.pinduoduo.com, REJECT

[URL Rewrite]
# Reject-dict 转换 (Surge 使用 reject-dict)
^https:\/\/api\.pinduoduo\.com\/api\/aristotle\/unrated_order_for_unreceived_tab\? _ reject-dict
^https:\/\/api\.pinduoduo\.com\/api\/aristotle\/query_order_list_tabs_element\? _ reject-dict
^https:\/\/api\.pinduoduo\.com\/api\/aquarius\/hungary\/global\/homepage\? _ reject-dict
^https:\/\/api\.pinduoduo\.com\/api\/caterham\/v3\/query\/order_express_group\? _ reject-dict
^https:\/\/api\.pinduoduo\.com\/search_hotquery\? _ reject-dict
^https:\/\/api\.pinduoduo\.com\/api\/zaire_biz\/chat\/resource\/get_list_data\? _ reject-dict
^https:\/\/api\.pinduoduo\.com\/api\/caterham\/v3\/query\/new_chat_group\? _ reject-dict
^https:\/\/api\.pinduoduo\.com\/api\/alexa\/goods\/back_up\? _ reject-dict
^https:\/\/api\.pinduoduo\.com\/api\/caterham\/v3\/query\/personal\? _ reject-dict
^https:\/\/api\.pinduoduo\.com\/api\/brand-olay\/goods_detail\/bybt_guide\? _ reject-dict
^https:\/\/api\.pinduoduo\.com\/api\/engels\/reviews\/require\/append\? _ reject-dict
^https:\/\/api\.pinduoduo\.com\/api\/caterham\/v3\/query\/my_order_group\? _ reject-dict
^https:\/\/api\.pinduoduo\.com\/api\/caterham\/v3\/query\/likes\? _ reject-dict
^https:\/\/api\.pinduoduo\.com\/api\/phantom\/gbdbpdv\/extra\? _ reject-dict
^https:\/\/api\.pinduoduo\.com\/api\/manufacturer\/cross\/shortcut\/list\? _ reject-dict
^https:\/\/api\.pinduoduo\.com\/api\/dunkirk\/liveactivity\/push\/create\/url\/report\? _ reject-dict
^https:\/\/api\.pinduoduo\.com\/api\/growth\/nagato\/app\/index\/gather\? _ reject-dict
^https:\/\/api\.pinduoduo\.com\/api\/engels\/wait\/receive\/review\? _ reject-dict
^https:\/\/api\.pinduoduo\.com\/api\/buffon\/nasus\/recommend\? _ reject-dict
^https:\/\/api\.pinduoduo\.com\/api\/caterham\/v2\/query\/goods_detail_with_tags\? _ reject-dict

[Script]
# 扫码取件脚本
拼多多_扫码取件 = type=http-response,pattern=^https:\/\/m\.pinduoduo\.net\/mdkd\/package\?from_app_scan,script-path=https://kelee.one/Resource/JavaScript/PinDuoDuo/PinDuoDuo_remove_ads.js,requires-body=true,max-size=0

# JSON-Del 字段剔除替代脚本
拼多多_首页精简_del = type=http-response,pattern=^https:\/\/api\.pinduoduo\.com\/api\/alexa\/homepage\/hub\?,requires-body=true,max-size=0,script-path=https://raw.githubusercontent.com/mieqq/mieqq/master/replace-body.js,argument=result.dy_module.irregular_banner_dy=&result.icon_set=&result.search_bar_hot_query=
拼多多_搜索推荐_del = type=http-response,pattern=^https:\/\/api\.pinduoduo\.com\/search\?,requires-body=true,max-size=0,script-path=https://raw.githubusercontent.com/mieqq/mieqq/master/replace-body.js,argument=expansion=
拼多多_个人中心_del = type=http-response,pattern=^https:\/\/api\.pinduoduo\.com\/api\/philo\/personal\/hub\?,requires-body=true,max-size=0,script-path=https://raw.githubusercontent.com/mieqq/mieqq/master/replace-body.js,argument=monthly_card_entrance=&personal_center_style_v2_vo=&icon_set.icons=&icon_set.top_personal_icons=&personal_banner=
拼多多_商品详情_del = type=http-response,pattern=^https:\/\/api\.pinduoduo\.com\/api\/oak\/integration\/render\?,requires-body=true,max-size=0,script-path=https://raw.githubusercontent.com/mieqq/mieqq/master/replace-body.js,argument=bottom_section_list=&ui.bottom_section=&ui.live_section.float_info=
拼多多_订单详情_del = type=http-response,pattern=^https:\/\/api\.pinduoduo\.com\/api\/caterham\/v3\/query\/order_detail_group\?,requires-body=true,max-size=0,script-path=https://raw.githubusercontent.com/mieqq/mieqq/master/replace-body.js,argument=data.goods_list=
拼多多_订单列表_del = type=http-response,pattern=^https:\/\/api\.pinduoduo\.com\/order\/,requires-body=true,max-size=0,script-path=https://raw.githubusercontent.com/mieqq/mieqq/master/replace-body.js,argument=marketing_banner_vo=&shipping.banner_above_recommend=

[MITM]
hostname = %APPEND% api.pinduoduo.com, m.pinduoduo.net
